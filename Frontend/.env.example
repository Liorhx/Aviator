# ==============================================================
# Aviator Frontend - Environment Variables (.env.example)
# ==============================================================

# Backend API & Socket URL:
# 1. Local Development (with Vite proxy): leave empty or http://localhost:3000
# 2. Vercel Services (monorepo full-stack on same domain): leave empty ("")
# 3. External Backend (e.g., backend hosted on Render, Railway, AWS EC2):
#    Set to your full backend URL: https://your-backend-api.onrender.com
VITE_API_URL=

